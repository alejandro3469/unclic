# Copy this file to .env and fill values.
# cp toolkit-fastflow/integrations/codex-governance/.env.example toolkit-fastflow/integrations/codex-governance/.env

# Required auth
OPENAI_API_KEY=sk-...

# Optional request-scoping headers
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

# Workspace context
CODEX_WORKSPACE_ID=

# Analytics API endpoint and query mapping
# Put the exact endpoint exposed for your workspace/admin setup.
CODEX_ANALYTICS_ENDPOINT=https://api.openai.com/v1/codex/analytics
CODEX_ANALYTICS_WORKSPACE_PARAM=workspace_id
CODEX_ANALYTICS_FROM_PARAM=start_date
CODEX_ANALYTICS_TO_PARAM=end_date
CODEX_ANALYTICS_GROUP_BY_PARAM=group_by
CODEX_ANALYTICS_GROUP_BY=
CODEX_ANALYTICS_LIMIT_PARAM=limit
CODEX_ANALYTICS_LIMIT=200
CODEX_ANALYTICS_CURSOR_PARAM=cursor
CODEX_ANALYTICS_NEXT_CURSOR_FIELD=next_cursor
CODEX_ANALYTICS_MAX_PAGES=500
CODEX_ANALYTICS_STOP_ON_EMPTY=true
CODEX_ANALYTICS_OUTPUT_DIR=toolkit-fastflow/integrations/codex-governance/exports/analytics

# Compliance API endpoint and query mapping
# Put the exact endpoint exposed for your workspace/admin setup.
CODEX_COMPLIANCE_ENDPOINT=https://api.openai.com/v1/codex/compliance
CODEX_COMPLIANCE_WORKSPACE_PARAM=workspace_id
CODEX_COMPLIANCE_FROM_PARAM=start_date
CODEX_COMPLIANCE_TO_PARAM=end_date
CODEX_COMPLIANCE_INCLUDE_CONTENT_PARAM=include_content
CODEX_COMPLIANCE_INCLUDE_CONTENT=true
CODEX_COMPLIANCE_LIMIT_PARAM=limit
CODEX_COMPLIANCE_LIMIT=200
CODEX_COMPLIANCE_CURSOR_PARAM=cursor
CODEX_COMPLIANCE_NEXT_CURSOR_FIELD=next_cursor
CODEX_COMPLIANCE_MAX_PAGES=1000
CODEX_COMPLIANCE_STOP_ON_EMPTY=true
CODEX_COMPLIANCE_OUTPUT_DIR=toolkit-fastflow/integrations/codex-governance/exports/compliance
