// Pipeline landing UnClic (repo nucleic): Next.js static export + deploy rsync a EC2 (Nginx).
// Requiere plugin "Docker Pipeline" en Jenkins (Manage Jenkins → Plugins → Available → "Docker").
//
// Agente Docker: node:22-alpine (algunas deps piden Node >= 22). Jenkins ejecuta el contenedor con -u jenkins:
// HOME puede quedar sin escribir → npm usa /.npm y falla con EACCES. Forzamos HOME y NPM_CONFIG_CACHE en el workspace.
//
// Variables opcionales del job (Jenkins → Configure → This project is parameterized o Environment variables):
//   DEPLOY_HOST     — IP o hostname EC2 (obligatorio para desplegar)
//   DEPLOY_USER     — usuario SSH (default ec2-user)
//   DEPLOY_PATH     — ruta remota document root (default /usr/share/nginx/landing)
//   DEPLOY_SSH_CREDENTIALS — (opcional) ID de credencial Jenkins tipo "SSH Username with private key"
//   UNC_APP_DIR     — (solo monorepo) ruta al package.json. En nucleic déjalo sin definir (usa '.').
//   NODE_HEAP_MB    — (opcional) límite heap V8 para `next build` en MiB (default 2048). En t3.micro (1 GiB RAM)
//                     sin swap puede matar el SO; añade swap 2G o sube a t3.small, o baja a 1024 si aún OOM.
//   NEXT_TELEMETRY_DISABLED=1 — ya se exporta en Build para menos ruido.
//
// Rama: el job debe usar Branch Specifier */main (no master).

def resolvedAppDir() {
    def d = env.UNC_APP_DIR?.trim()
    return (d && d.length() > 0) ? d : '.'
}

pipeline {
    agent {
        docker {
            image 'node:22-alpine'
            reuseNode true
        }
    }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        DEPLOY_PATH = "${env.DEPLOY_PATH ?: '/usr/share/nginx/landing'}"
        NODE_HEAP_MB = "${env.NODE_HEAP_MB?.trim() ?: '2048'}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def br = env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'unknown'
                    def sha = env.GIT_COMMIT ?: ''
                    def shortSha = (sha.length() >= 7) ? sha.substring(0, 7) : (sha ?: '?')
                    echo "Rama: ${br}; commit: ${shortSha}"
                }
            }
        }
        stage('Install') {
            steps {
                script {
                    env._UNC_DIR = resolvedAppDir()
                }
                dir("${env._UNC_DIR}") {
                    sh '''
                        set -e
                        mkdir -p "${WORKSPACE}/.npm-cache" "${WORKSPACE}/.jenkins-container-home"
                        export HOME="${WORKSPACE}/.jenkins-container-home"
                        export NPM_CONFIG_CACHE="${WORKSPACE}/.npm-cache"
                        node -v && npm -v
                        # Instalación previa a medias (t3.micro + volumen) provoca TAR_ENTRY_ERROR; empezar limpio
                        rm -rf node_modules
                        npm ci
                    '''
                }
            }
        }
        stage('Build') {
            steps {
                dir("${env._UNC_DIR}") {
                    sh '''
                        export HOME="${WORKSPACE}/.jenkins-container-home"
                        export NPM_CONFIG_CACHE="${WORKSPACE}/.npm-cache"
                        export NEXT_TELEMETRY_DISABLED=1
                        export NODE_OPTIONS="--max-old-space-size=${NODE_HEAP_MB}"
                        echo "NODE_HEAP_MB=${NODE_HEAP_MB} NODE_OPTIONS=${NODE_OPTIONS}"
                        npm run build
                        test -d out && ls -la out/ | head -25
                    '''
                }
            }
        }
        stage('Deploy') {
            when {
                expression {
                    def b = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    return b.replaceFirst('^origin/', '') == 'main' || b.endsWith('/main')
                }
            }
            steps {
                script {
                    def host = env.DEPLOY_HOST?.trim() ?: ''
                    def user = env.DEPLOY_USER?.trim() ?: 'ec2-user'
                    def credId = env.DEPLOY_SSH_CREDENTIALS?.trim() ?: ''
                    def appDir = resolvedAppDir()
                    def outPath = "${appDir}/out"

                    if (!host) {
                        echo 'DEPLOY_HOST vacío: se omite Deploy (solo artefacto en workspace). Configura DEPLOY_HOST en el job para publicar.'
                        return
                    }

                    sh 'apk add --no-cache openssh-client rsync'

                    def rsyncCmd = """
                        rsync -avz --delete -e "ssh -o StrictHostKeyChecking=accept-new" \
                          ${outPath}/ ${user}@${host}:${env.DEPLOY_PATH}/
                    """.trim()

                    echo "Desplegando ${outPath}/ → ${user}@${host}:${env.DEPLOY_PATH}"

                    if (credId) {
                        sshagent(credentials: [credId]) {
                            sh rsyncCmd
                        }
                    } else {
                        sh rsyncCmd
                    }
                }
            }
        }
    }
    post {
        success {
            echo 'Pipeline UnClic OK. Si hubo DEPLOY_HOST, Nginx debería servir el nuevo out/.'
        }
        failure {
            echo 'Pipeline falló: revisar Install (npm ci), Build (next build) o Deploy (ssh/rsync).'
        }
    }
}

// Alternativa sin Docker: si no puedes instalar el plugin Docker Pipeline, usa Jenkinsfile.no-docker
// (agent any + NodeJS tool en Jenkins o Node instalado en el servidor).
