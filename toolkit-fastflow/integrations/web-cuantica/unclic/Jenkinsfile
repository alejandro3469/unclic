// Pipeline landing UnClic (repo nucleic en Gitea): build Next.js static export + deploy rsync a EC2 (Nginx).
// Tras editar: sincronizar a Gitea (ver scripts/update-nucleic-from-monorepo.sh y docs/JENKINS-NUCLEIC-DEPLOY.md).
//
// Repo nucleic: la raíz del clone ES el proyecto (app/, package.json, Jenkinsfile). APP_DIR = '.'.
// Si algún día clonas un monorepo, define en el job la variable de entorno UNC_APP_DIR (ej. toolkit-fastflow/integrations/web-cuantica/unclic).
//
// Agente Docker (node:20-alpine): en Deploy se instalan openssh-client y rsync dentro del contenedor.
// Alternativa sin Docker: agent any + NodeJS tool en Jenkins (ver comentario al final).
//
// Variables de job (Jenkins → Configure):
//   DEPLOY_HOST     — IP o hostname EC2 (obligatorio para desplegar)
//   DEPLOY_USER     — usuario SSH (default ec2-user)
//   DEPLOY_PATH     — ruta remota document root (default /usr/share/nginx/landing)
//   DEPLOY_SSH_CREDENTIALS — (opcional) ID de credencial Jenkins tipo "SSH Username with private key" para rsync/ssh
//
// Rama: el job debe usar Branch Specifier */main (no master).

def resolvedAppDir() {
    def d = env.UNC_APP_DIR?.trim()
    return (d && d.length() > 0) ? d : '.'
}

pipeline {
    agent {
        docker {
            image 'node:20-alpine'
            reuseNode true
        }
    }
    options {
        timestamps()
        disableConcurrentBuilds()
    }
    environment {
        DEPLOY_PATH = "${env.DEPLOY_PATH ?: '/usr/share/nginx/landing'}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh "echo 'Rama: ${env.BRANCH_NAME ?: GIT_BRANCH}'; git rev-parse --short HEAD"
            }
        }
        stage('Install') {
            steps {
                script {
                    env._UNC_DIR = resolvedAppDir()
                }
                dir("${env._UNC_DIR}") {
                    sh 'node -v && npm -v'
                    sh 'npm ci'
                }
            }
        }
        stage('Build') {
            steps {
                dir("${env._UNC_DIR}") {
                    sh 'npm run build'
                    sh 'test -d out && ls -la out/ | head -25'
                }
            }
        }
        stage('Deploy') {
            when {
                expression {
                    def b = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    return b.replaceFirst('^origin/', '') == 'main' || b.endsWith('/main')
                }
            }
            steps {
                script {
                    def host = env.DEPLOY_HOST?.trim() ?: ''
                    def user = env.DEPLOY_USER?.trim() ?: 'ec2-user'
                    def credId = env.DEPLOY_SSH_CREDENTIALS?.trim() ?: ''
                    def appDir = resolvedAppDir()
                    def outPath = "${appDir}/out"

                    if (!host) {
                        echo 'DEPLOY_HOST vacío: se omite Deploy (solo artefacto en workspace). Configura DEPLOY_HOST en el job para publicar.'
                        return
                    }

                    sh 'apk add --no-cache openssh-client rsync'

                    def rsyncCmd = """
                        rsync -avz --delete -e "ssh -o StrictHostKeyChecking=accept-new" \
                          ${outPath}/ ${user}@${host}:${env.DEPLOY_PATH}/
                    """.trim()

                    echo "Desplegando ${outPath}/ → ${user}@${host}:${env.DEPLOY_PATH}"

                    if (credId) {
                        sshagent(credentials: [credId]) {
                            sh rsyncCmd
                        }
                    } else {
                        sh rsyncCmd
                    }
                }
            }
        }
    }
    post {
        success {
            echo 'Pipeline UnClic OK. Si hubo DEPLOY_HOST, Nginx debería servir el nuevo out/.'
        }
        failure {
            echo 'Pipeline falló: revisar Install (npm ci), Build (next build) o Deploy (ssh/rsync).'
        }
    }
}

// --- Sin Docker en el agente Jenkins ---
// 1) Manage Jenkins → Global Tool Configuration → NodeJS → añade instalación "Node20".
// 2) Sustituye agent { docker { ... } } por:  agent any
// 3) En stage Install, antes de npm:  env.PATH = "${tool('Node20')}/bin:${env.PATH}"
// 4) En Deploy, el agente debe tener rsync y ssh (Amazon Linux: yum install -y rsync openssh-clients).
