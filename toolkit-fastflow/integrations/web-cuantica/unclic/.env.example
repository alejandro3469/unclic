# Shadcnblocks private registry (CLI v3).
# Copy to .env.local and set your key. Do not commit .env.local.
# Get your key: https://www.shadcnblocks.com — Dashboard → API Keys
#
# For `npx shadcn add @shadcnblocks/...` the CLI reads this from the environment.
# Option A: export SHADCNBLOCKS_API_KEY=your_key before running the command.
# Option B: use dotenv-cli — npx dotenv -e .env.local -- npx shadcn add @shadcnblocks/hero2
SHADCNBLOCKS_API_KEY=your_api_key_here

# Acceso solo a correos concretos (Jenkins, Gitea, POS, hub, Cloudcraft en el sitio).
# Con output estático la lista viaja en el bundle (NEXT_PUBLIC_*); para seguridad real usa Basic Auth / VPN en Nginx.
# Producción recomendada (prueba remota con tu correo @unclic.consulting):
# NEXT_PUBLIC_DEMO_ACCESS_MODE=allowlist
# NEXT_PUBLIC_DEMO_ALLOWED_EMAILS=alejandro@unclic.consulting
# Opcional: segundo correo o personal — alejandro.perez3469@gmail.com,alejandro@unclic.consulting
# Opcional: en allowlist, ?unlock=1 no funciona; usa un token secreto para preview interno:
# NEXT_PUBLIC_DEMO_UNLOCK_TOKEN=pon-un-token-largo-aqui

# Demos UnClic — URLs y usuario invitado (solo POS). Ver docs/GITEA-JENKINS-HTTPS-USUARIO-POS-Y-LINK-DEMO.md
NEXT_PUBLIC_DEMO_JENKINS_URL=https://jenkins.unclic.consulting
NEXT_PUBLIC_DEMO_GITEA_URL=https://gitea.unclic.consulting
NEXT_PUBLIC_DEMO_POS_URL=https://pos.unclic.consulting
NEXT_PUBLIC_DEMO_REGISTRY_URL=https://registry.unclic.consulting
# Usuario invitado para Jenkins/Gitea (acceso solo POS). Si no se define contraseña, en la web se muestra "Solicitar en contacto".
NEXT_PUBLIC_DEMO_GUEST_USER=demo-invitado
# NEXT_PUBLIC_DEMO_GUEST_PASSWORD=your_guest_password

# Email gate demo: Formspree form ID para /demo/access (solo el ID, ej. xyzwabcd → https://formspree.io/f/xyzwabcd).
# Crear formulario en https://formspree.io y activar Autoresponder para correo de bienvenida; o Zapier/Make + Gmail. Ver docs/PLAN-PRODUCCION-UNClic-DEMO-EMAIL-LINKEDIN.md
# NEXT_PUBLIC_DEMO_ACCESS_FORM_ID=xyzwabcd

# Cloudcraft — diagrama de la arquitectura de la demo (FastFlow, Jenkins, Gitea, POS). Ver toolkit-fastflow/docs/GUIA-CLOUDCRAFT-COMPLETA.md
# Blueprint de la demo: https://app.cloudcraft.co/blueprint/504a8a6e-fca3-404d-a280-63ab8fe9d0c1
# Para enlace público o embed: en Cloudcraft → Share & Export → Get shareable link; pegar aquí (incluye ?key=). No commitear .env.local con key.
# NEXT_PUBLIC_CLOUDCRAFT_VIEW_URL=https://app.cloudcraft.co/view/504a8a6e-fca3-404d-a280-63ab8fe9d0c1?key=TU_KEY
# NEXT_PUBLIC_CLOUDCRAFT_EMBED_URL=https://app.cloudcraft.co/view/504a8a6e-fca3-404d-a280-63ab8fe9d0c1?key=TU_KEY&embed=true
# Captura fiel del diagrama (visible sin login). Coloca PNG/WebP en public/images/architecture/ y commitea.
# NEXT_PUBLIC_CLOUDCRAFT_STATIC_IMAGE=/images/architecture/cloudcraft-demo.webp

# Perfil público (CV, LinkedIn, GitHub — aparecen en cabecera y pie si están definidos)
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/TU-USUARIO
# NEXT_PUBLIC_GITHUB_URL=https://github.com/TU-USUARIO

# Hub de demos — opcionales (si no hay URL, la tarjeta muestra "Configurar URL en .env")
# Ejemplos HTTPS públicos (ajusta a tus instancias reales):
# NEXT_PUBLIC_DEMO_K8S_URL=https://k8s.unclic.consulting
# NEXT_PUBLIC_DEMO_TERRAFORM_URL=https://github.com/TU_ORG/TU_REPO/actions  # o consola/estado en S3 con acceso de lectura documentado
# Pulumi Cloud (organización/proyecto/stack) o URL interna de “outputs”:
# NEXT_PUBLIC_DEMO_PULUMI_URL=https://app.pulumi.com/TU_ORG/TU_PROYECTO/TU_STACK
# Repo de documentación técnica (toolkit FastFlow en GitHub u otro)
# NEXT_PUBLIC_DOCS_REPO_URL=https://github.com/org/toolkit-fastflow
# Portal de correo del cliente (opcional; por defecto enlace a producto Gmail Workspace)
# NEXT_PUBLIC_MAIL_PORTAL_URL=https://mail.google.com
# Doc Cloudcraft in Datadog (por defecto ya apunta a docs.datadoghq.com/datadog_cloudcraft/)
# NEXT_PUBLIC_DATADOG_CLOUDCRAFT_DOC_URL=
