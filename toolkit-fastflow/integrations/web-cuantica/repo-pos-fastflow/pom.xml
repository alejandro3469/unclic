	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.6.3</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>mx.com.endtoend</groupId>
	<artifactId>pos-online</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>pos-online</name>
	<description>Sistema POS Unificado</description>
	<properties>
		<java.version>11</java.version>
		<querydsl.version>5.0.0</querydsl.version>
		<sonar.coverage.jacoco.xmlReportPaths>
			${project.basedir}/.../${aggregate.report.dir}</sonar.coverage.jacoco.xmlReportPaths>
