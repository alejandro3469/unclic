<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Checkstyle para Jenkins (Lint stage).
  Puedes endurecer reglas bajando maxAllowedViolations en pom.xml y ajustando este archivo.
  Referencia: https://checkstyle.org/config.html
-->
<module name="Checker">
  <module name="FileLength">
    <property name="max" value="2000"/>
    <property name="fileExtensions" value="java"/>
  </module>
</module>
